                        √(FTF.expect (FTF.joint p r) fun o => FTF.cost (FTF.globalWeight nA nB a b) x (C o.1 o.2)) ≤
                          √α * ((1 + √α) * √κ + 1) * √(FTF.cost (FTF.globalWeight nA nB a b) x ref) + (1 + √α) * √Q
